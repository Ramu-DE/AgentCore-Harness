# ─────────────────────────────────────────────────────────────────────────────
# AgentCore-Harness — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS core ─────────────────────────────────────────────────────────────────
# Required for: Bedrock (LLM), DynamoDB (tool data), Lambda (tool execution),
#               AgentCore runtime invocation, SSM (knowledge base ID)
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=<your-access-key>
AWS_SECRET_ACCESS_KEY=<your-secret-key>
# AWS_SESSION_TOKEN=<token>   # uncomment when using temporary credentials / SSO

# ── AgentCore Gateway OAuth (Cognito client_credentials) ─────────────────────
# Used by: CustomerAssistantAgent MCP client, test_gateway.py
# Obtain from: AWS Console → Cognito → User Pools → App clients
GATEWAY_URL=https://<your-gateway-id>.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp
GATEWAY_CLIENT_ID=<cognito-app-client-id>
GATEWAY_CLIENT_SECRET=<cognito-app-client-secret>   # NEVER hardcode in agentcore.json
GATEWAY_TOKEN_ENDPOINT=https://<your-pool-domain>.auth.us-west-2.amazoncognito.com/oauth2/token
GATEWAY_SCOPE=gateway/invoke

# ── AgentCore Runtime ─────────────────────────────────────────────────────────
# Used by: streamlit-ui/streamlit_app.py
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:<account-id>:runtime/<runtime-id>
AGENTCORE_MEMORY_ID=<project-name>_CustomerAssistantMemory-<suffix>

# ── Cognito (Streamlit UI login) ──────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-west-2_<pool-id>
COGNITO_APP_CLIENT_ID=<user-pool-app-client-id>

# ── DeepEval (LLM-as-judge cloud dashboard) ───────────────────────────────────
# Required for: evals/test_live.py, cloud result tracking at confident-ai.com
# Get from: https://app.confident-ai.com → Settings → API Keys
DEEPEVAL_API_KEY=<deepeval-api-key>

# ── GitHub Actions CI ─────────────────────────────────────────────────────────
# Required for: .github/workflows/evals.yml nightly job (OIDC role assumption)
# Store in: GitHub → Settings → Secrets → Actions
# AWS_EVAL_ROLE_ARN=arn:aws:iam::<account-id>:role/github-eval-role

# ── Langfuse tracing (optional but recommended) ───────────────────────────────
# Required for: online eval traces, production observability
# Get from: https://cloud.langfuse.com → Settings → API Keys
# LANGFUSE_PUBLIC_KEY=pk-lf-<key>
# LANGFUSE_SECRET_KEY=sk-lf-<key>
# LANGFUSE_HOST=https://cloud.langfuse.com   # or your self-hosted URL
